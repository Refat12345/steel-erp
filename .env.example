# Copy to .env.local for development. On Vercel, set these in Project → Settings → Environment Variables.

# PostgreSQL — Supabase: copy BOTH from Dashboard → Connect → ORM → Prisma
DATABASE_URL="postgresql://...pooler...?pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://...@db....supabase.co:5432/postgres?sslmode=require"

# Single URL only (e.g. local Postgres): set DATABASE_URL and set DIRECT_URL to the same value

# NextAuth (required in production)
# Generate secret: openssl rand -hex 32
NEXTAUTH_SECRET=""
# Must match the public URL (no trailing slash), e.g. https://steel-erp-xxxxx.vercel.app
NEXTAUTH_URL="http://localhost:3000"

# Optional
# LOG_LEVEL=info

# External vs internal weigh cross-check warning threshold (kg). Default: 200
# WEIGHBRIDGE_DISCREPANCY_WARN_KG=200

# External weighbridge weight bounds (kg). Defaults match weight-bounds.ts.
# GROSS_MAX_KG=100000
# TARE_MIN_KG=3000
# TARE_MAX_KG=100000
# GROSS_MIN_KG=5000
# NET_MIN_KG=500

# Shared secret for scheduled maintenance endpoints (e.g. POST /api/maintenance/cleanup-idempotency).
# Generate: openssl rand -hex 32. Leave blank to require an admin session instead.
# CLEANUP_SECRET=""
