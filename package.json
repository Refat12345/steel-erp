{
  "name": "steel-erp",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "postinstall": "prisma generate",
    "dev": "next dev",
    "dev:lan": "next dev -H 0.0.0.0",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "db:migrate": "npx prisma migrate dev",
    "db:seed": "npx tsx prisma/seed.ts",
    "db:reset": "npx prisma migrate reset --force",
    "db:reset-admin": "npx tsx scripts/reset-db-admin-only.ts",
    "db:studio": "npx prisma studio",
    "test": "vitest run",
    "test:watch": "vitest",
    "prod:start": "pm2 start ecosystem.config.cjs",
    "prod:stop": "pm2 stop steel-erp",
    "prod:logs": "pm2 logs steel-erp",
    "prod:restart": "pm2 restart steel-erp",
    "reset-passwords": "npx tsx scripts/reset-demo-passwords.ts",
    "demo:reset-db": "npx tsx scripts/reset-full-db.ts",
    "demo:seed": "npx tsx scripts/seed-full-demo.ts",
    "demo:full-reset": "npx tsx scripts/reset-full-db.ts && npx tsx scripts/seed-full-demo.ts",
    "rbac:sync": "npx tsx scripts/sync-rbac.ts",
    "rbac:sync:dry": "npx tsx scripts/sync-rbac.ts --dry-run"
  },
  "prisma": {
    "seed": "npx tsx prisma/seed.ts"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.1",
    "@base-ui/react": "^1.3.0",
    "@hookform/resolvers": "^5.2.2",
    "@prisma/client": "^6.19.3",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "decimal.js": "^10.6.0",
    "dotenv": "^17.4.0",
    "lucide-react": "^1.7.0",
    "next": "16.2.4",
    "next-auth": "^4.24.13",
    "next-themes": "^0.4.6",
    "pg": "^8.20.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "prisma": "^6.19.3",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-hook-form": "^7.72.1",
    "recharts": "^3.8.1",
    "shadcn": "^4.1.2",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.2",
    "tailwindcss": "^4",
    "tsx": "^4.21.0",
    "typescript": "^5",
    "vitest": "^4.1.4"
  }
}
