generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  // Supabase: pooled URL for the app; direct URL for `prisma migrate` / introspection
  directUrl = env("DIRECT_URL")
}

// ─── Enums ────────────────────────────────────────────────────────

enum ContractStatus {
  active
  suspended
  closed
}

enum OverrideType {
  grant
  revoke
}

enum AuditAction {
  create
  update
  status_change
  upload
  delete
}

enum SalesOrderKind {
  REBAR
  SHORTBAR_1_4M
  SHORTBAR_4_12M
  SCRAP
  BILLET_WIRE
  REBAR_UNDER_70CM
  BILLET_SCRAP_10M
  SCRAP_50CM_1M
}

enum SalesOrderGrade {
  FIRST
  SECOND
}

enum SettlementMode {
  CREDIT
  PAYMENT_PLAN
}

enum SalesOrderStatus {
  draft
  approved
  in_progress
  completed
  cancelled
}

enum ToleranceType {
  percentage
  weight
}

enum SliceStatus {
  pending
  partial
  paid
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  CHECK
}

enum TruckStatus {
  Queued
  Approved
  FirstWeigh
  Loading
  OnScale
  LoadingComplete
  SecondWeigh
  Completed
  Cancelled
}

// ─── Billet Receiving (Purchasing) ────────────────────────────────

enum SupplierContractStatus {
  Active
  Completed
  Cancelled
}

enum BilletReceiptStatus {
  Registered
  Loaded
  Unloading
  AwaitingExit
  Completed
  Cancelled
}

// ─── Finished-Goods Stock (Warehouse) ─────────────────────────────

// A stock location's operational classification. This is a DISPLAY /
// grouping attribute — it does NOT redefine the commercial grade.
// GOVERNORATES is first-grade rebar too; "محافظات" is only a naming/
// distinction label and carries no destination binding or load restriction.
enum StockLocationSegment {
  GENERAL // نخب أول عام
  GOVERNORATES // نخب أول محافظات — تمييز اسمي فقط
  ISOLATION // نخب ثاني
  SHORTBAR // قصائر — بالطن
}

// Counting unit for a location. Rebar sites count in bundles; shortbar
// zones count in tons. Stored on both the location and every movement so
// the ledger is self-describing.
enum StockUnit {
  BUNDLE
  TON
}

// Work shift of the operational day (08:00 → 08:00 next day).
// MORNING = 08:00–20:00, EVENING = 20:00–08:00. Stored on PRODUCTION_IN
// movements so a clerk recording a few minutes past a shift boundary can
// assign the entry to the shift it actually belongs to.
enum StockShift {
  MORNING
  EVENING
}

// Movement types in the stock ledger. The current balance of a location is
// ALWAYS computed as SUM(quantity) over its movements — never stored — so it
// can never drift (same philosophy as the billet module).
enum StockMovementType {
  OPENING_BALANCE // الجرد الافتتاحي عند التفعيل
  PRODUCTION_IN // دخول إنتاج يدوي
  TRANSFER_OUT // خروج ترحيل (سالب)
  TRANSFER_IN // دخول ترحيل (موجب)
  LOAD_OUT // خصم عند إغلاق الشاحنة (سالب)
  ADJUSTMENT // تصحيح جرد (± بصلاحية)
}

// ─── Authentication & Permissions ─────────────────────────────────

model User {
  id           Int      @id @default(autoincrement())
  username     String   @unique
  passwordHash String   @map("password_hash")
  fullName     String   @map("full_name")
  roleCode     String   @map("role_code")
  /** UI language preference: "ar" (default) or "en". Mirrored in the NEXT_LOCALE cookie. */
  locale       String   @default("ar")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  createdById  Int?     @map("created_by_id")

  role                Role                     @relation(fields: [roleCode], references: [code])
  creator             User?                    @relation("UserCreator", fields: [createdById], references: [id])
  createdUsers        User[]                   @relation("UserCreator")
  permissionOverrides UserPermissionOverride[]

  customersCreated     Customer[]               @relation("CustomerCreator")
  customersUpdated     Customer[]               @relation("CustomerUpdater")
  contractsCreated     MasterContract[]         @relation("ContractCreator")
  contractsUpdated     MasterContract[]         @relation("ContractUpdater")
  attachmentsUploaded  ContractAttachment[]     @relation("AttachmentUploader")
  permOverridesGranted UserPermissionOverride[] @relation("OverrideGranter")
  auditLogs            AuditLog[]               @relation("AuditLogUser")
  salesOrdersCreated   SalesOrder[]             @relation("SalesOrderCreator")
  salesOrdersUpdated   SalesOrder[]             @relation("SalesOrderUpdater")
  paymentsCreated      Payment[]                @relation("PaymentCreator")
  trucksCreated        TruckOperation[]         @relation("TruckCreator")
  trucksClosed         TruckOperation[]         @relation("TruckCloser")
  trucksLoaded         TruckOperation[]         @relation("TruckLoader")
  bridgeRoundsLoaded   BridgeRound[]            @relation("BridgeRoundLoader")
  stockMovements       StockMovement[]          @relation("StockMovementCreator")
  idempotencyKeys      IdempotencyKey[]

  billetContractsCreated    SupplierContract[]           @relation("BilletContractCreator")
  billetContractsUpdated    SupplierContract[]           @relation("BilletContractUpdater")
  billetReceiptsCreated     BilletReceipt[]              @relation("BilletReceiptCreator")
  billetReceiptsClosed      BilletReceipt[]              @relation("BilletReceiptCloser")
  billetAttachmentsUploaded BilletReceiptAttachment[]    @relation("BilletAttachmentUploader")
  billetContractAttachments SupplierContractAttachment[] @relation("BilletContractAttachmentUploader")

  @@map("users")
}

model Role {
  code        String @id
  displayName String @map("display_name")
  /// English display name. Nullable until backfilled from rbac-source.ts;
  /// rendered via localizedName() with an Arabic fallback when empty.
  displayNameEn String? @map("display_name_en")

  users              User[]
  defaultPermissions RoleDefaultPermission[]

  @@map("roles")
}

model Permission {
  code        String @id
  displayName String @map("display_name")
  /// English display name. Nullable until backfilled from rbac-source.ts;
  /// rendered via localizedName() with an Arabic fallback when empty.
  displayNameEn String? @map("display_name_en")
  module      String
  description String @default("")

  roleDefaults RoleDefaultPermission[]
  overrides    UserPermissionOverride[]

  @@map("permissions")
}

model RoleDefaultPermission {
  roleCode       String @map("role_code")
  permissionCode String @map("permission_code")

  role       Role       @relation(fields: [roleCode], references: [code])
  permission Permission @relation(fields: [permissionCode], references: [code])

  @@id([roleCode, permissionCode])
  @@map("role_default_permissions")
}

model UserPermissionOverride {
  id             Int          @id @default(autoincrement())
  userId         Int          @map("user_id")
  permissionCode String       @map("permission_code")
  overrideType   OverrideType @map("override_type")
  grantedById    Int          @map("granted_by_id")
  grantedAt      DateTime     @default(now()) @map("granted_at")

  user       User       @relation(fields: [userId], references: [id])
  permission Permission @relation(fields: [permissionCode], references: [code])
  granter    User       @relation("OverrideGranter", fields: [grantedById], references: [id])

  @@unique([userId, permissionCode])
  @@map("user_permission_overrides")
}

// ─── Customers & Contracts ────────────────────────────────────────

model Customer {
  id                     Int      @id @default(autoincrement())
  code                   String   @unique // auto-generated: C-0001
  fullName               String   @map("full_name")
  fatherName             String   @map("father_name")
  nationalId             String   @unique @map("national_id")
  phonePrimary           String   @map("phone_primary")
  phoneSecondary         String?  @map("phone_secondary")
  companyAddress         String   @map("company_address")
  commercialRegistration String?  @map("commercial_registration")
  notes                  String?
  isActive               Boolean  @default(true) @map("is_active")
  createdAt              DateTime @default(now()) @map("created_at")
  updatedAt              DateTime @updatedAt @map("updated_at")
  createdById            Int      @map("created_by_id")
  updatedById            Int?     @map("updated_by_id")

  creator         User             @relation("CustomerCreator", fields: [createdById], references: [id])
  updater         User?            @relation("CustomerUpdater", fields: [updatedById], references: [id])
  contracts       MasterContract[]
  payments        Payment[]
  truckOperations TruckOperation[] @relation("TruckCustomer")

  @@index([phonePrimary])
  @@index([createdAt])
  @@map("customers")
}

model Destination {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  /// English display name. Nullable until backfilled from en-labels.ts;
  /// rendered via localizedName() with an Arabic fallback when empty.
  nameEn    String?  @map("name_en")
  details   String?
  isActive  Boolean  @default(true) @map("is_active")
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  truckOperations TruckOperation[]

  @@index([isActive, sortOrder])
  @@map("destinations")
}

model MasterContract {
  contractNumber String         @id @map("contract_number") // YY-CC
  customerId     Int            @map("customer_id")
  attachmentPath String         @map("attachment_path") // mandatory signed-contract scan
  status         ContractStatus @default(active)
  notes          String?
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")
  createdById    Int            @map("created_by_id")
  updatedById    Int?           @map("updated_by_id")

  customer    Customer             @relation(fields: [customerId], references: [id])
  creator     User                 @relation("ContractCreator", fields: [createdById], references: [id])
  updater     User?                @relation("ContractUpdater", fields: [updatedById], references: [id])
  attachments ContractAttachment[]
  salesOrders SalesOrder[]

  @@unique([customerId, contractNumber])
  @@index([customerId])
  @@index([status])
  @@index([createdAt])
  @@map("master_contracts")
}

model ContractAttachment {
  id             Int      @id @default(autoincrement())
  contractNumber String   @map("contract_number")
  filePath       String   @map("file_path")
  fileName       String   @map("file_name")
  fileSize       Int      @map("file_size") // bytes
  uploadedAt     DateTime @default(now()) @map("uploaded_at")
  uploadedById   Int      @map("uploaded_by_id")

  contract MasterContract @relation(fields: [contractNumber], references: [contractNumber])
  uploader User           @relation("AttachmentUploader", fields: [uploadedById], references: [id])

  @@index([contractNumber])
  @@map("contract_attachments")
}

// ─── Sales Orders ─────────────────────────────────────────────────

model SalesOrder {
  orderNumber         String           @id @map("order_number") // YY-CC-OOO
  contractNumber      String           @map("contract_number")
  kind                SalesOrderKind
  grade               SalesOrderGrade?
  settlementMode      SettlementMode   @map("settlement_mode")
  paymentDeadlineDays Int?             @map("payment_deadline_days")
  totalQtyTons        Decimal          @map("total_qty_tons") @db.Decimal(12, 3)
  toleranceType       ToleranceType    @map("tolerance_type")
  toleranceValue      Decimal          @map("tolerance_value") @db.Decimal(8, 3)
  specialRatioPct     Decimal?         @map("special_ratio_pct") @db.Decimal(5, 2)
  bufferPct           Decimal?         @map("buffer_pct") @db.Decimal(5, 2)
  orderDate           DateTime         @map("order_date") @db.Date
  deliveryDate        DateTime         @map("delivery_date") @db.Date
  status              SalesOrderStatus @default(draft)
  notes               String?
  createdAt           DateTime         @default(now()) @map("created_at")
  updatedAt           DateTime         @updatedAt @map("updated_at")
  createdById         Int              @map("created_by_id")
  updatedById         Int?             @map("updated_by_id")

  contract           MasterContract      @relation(fields: [contractNumber], references: [contractNumber])
  creator            User                @relation("SalesOrderCreator", fields: [createdById], references: [id])
  updater            User?               @relation("SalesOrderUpdater", fields: [updatedById], references: [id])
  items              OrderItem[]
  paymentSlices      PaymentSlice[]
  paymentAllocations PaymentAllocation[]
  truckOperations    TruckOperation[]

  @@index([contractNumber])
  @@index([status])
  @@index([kind])
  @@index([createdAt])
  @@map("sales_orders")
}

model OrderItem {
  id          Int     @id @default(autoincrement())
  orderNumber String  @map("order_number")
  sizeId      Int     @map("size_id")
  pricePerTon Decimal @map("price_per_ton") @db.Decimal(12, 2)

  salesOrder SalesOrder @relation(fields: [orderNumber], references: [orderNumber])
  size       SizeLookup @relation(fields: [sizeId], references: [id])

  @@unique([orderNumber, sizeId])
  @@map("order_items")
}

model PaymentSlice {
  id           Int         @id @default(autoincrement())
  orderNumber  String      @map("order_number")
  postingDate  DateTime    @map("posting_date") @db.Date
  quantityTons Decimal     @map("quantity_tons") @db.Decimal(12, 3)
  amountDue    Decimal     @map("amount_due") @db.Decimal(14, 2)
  deadline     DateTime    @db.Date
  status       SliceStatus @default(pending)
  createdAt    DateTime    @default(now()) @map("created_at")

  salesOrder SalesOrder @relation(fields: [orderNumber], references: [orderNumber])

  @@index([orderNumber])
  @@index([deadline])
  @@map("payment_slices")
}

// ─── Payments ─────────────────────────────────────────────────────

model Payment {
  id              Int           @id @default(autoincrement())
  customerId      Int           @map("customer_id")
  amount          Decimal       @db.Decimal(14, 2)
  method          PaymentMethod
  paymentDate     DateTime      @map("payment_date") @db.Date
  referenceNumber String?       @map("reference_number")
  notes           String?
  createdById     Int           @map("created_by_id")
  createdAt       DateTime      @default(now()) @map("created_at")

  customer    Customer            @relation(fields: [customerId], references: [id])
  creator     User                @relation("PaymentCreator", fields: [createdById], references: [id])
  allocations PaymentAllocation[]

  @@index([customerId])
  @@index([paymentDate])
  @@index([createdAt])
  @@map("payments")
}

model PaymentAllocation {
  id              Int      @id @default(autoincrement())
  paymentId       Int      @map("payment_id")
  orderNumber     String   @map("order_number")
  allocatedAmount Decimal  @map("allocated_amount") @db.Decimal(14, 2)
  createdAt       DateTime @default(now()) @map("created_at")

  payment    Payment    @relation(fields: [paymentId], references: [id])
  salesOrder SalesOrder @relation(fields: [orderNumber], references: [orderNumber])

  @@unique([paymentId, orderNumber])
  @@index([orderNumber])
  @@map("payment_allocations")
}

// ─── Audit ────────────────────────────────────────────────────────

model AuditLog {
  id         Int         @id @default(autoincrement())
  userId     Int         @map("user_id")
  action     AuditAction
  entityType String      @map("entity_type")
  entityId   String      @map("entity_id")
  details    Json?
  createdAt  DateTime    @default(now()) @map("created_at")

  user User @relation("AuditLogUser", fields: [userId], references: [id])

  @@index([entityType, entityId])
  @@index([userId])
  @@index([createdAt])
  @@map("audit_logs")
}

// ─── Lookup Tables ────────────────────────────────────────────────

model SizeLookup {
  id                 Int     @id @default(autoincrement())
  code               String  @unique
  displayName        String  @map("display_name")
  /// English display name. Nullable until backfilled from en-labels.ts;
  /// rendered via localizedName() with an Arabic fallback when empty.
  displayNameEn      String? @map("display_name_en")
  isSpecialRatio     Boolean @default(false) @map("is_special_ratio")
  subjectToTolerance Boolean @default(true) @map("subject_to_tolerance")
  isBundleType       Boolean @default(true) @map("is_bundle_type")
  isActive           Boolean @default(true) @map("is_active")
  sortOrder          Int     @default(0) @map("sort_order")

  orderItems        OrderItem[]
  weighSessions     WeighSession[]
  truckRequestItems TruckRequestItem[]
  bridgeRounds      BridgeRound[]
  stockLocations    StockLocation[]
  stockMovements    StockMovement[]

  @@map("size_lookup")
}

// ─── Finished-Goods Stock (Warehouse) ─────────────────────────────
//
// A ledger-based stock module for the finished-goods yard. Balances are
// NEVER stored — each location's balance is computed from the SUM of its
// StockMovement rows (mirrors the billet module's "remaining never stored"
// rule). There is intentionally NO max-capacity concept: the system only
// tracks what is currently present (bundles for rebar, tons for shortbar).

model StockYard {
  id       Int     @id @default(autoincrement())
  code     String  @unique // FRONT | BACK
  nameAr   String  @map("name_ar")
  /// English display name. Nullable; rendered via localizedName() with an
  /// Arabic fallback when empty.
  nameEn   String? @map("name_en")
  isActive Boolean @default(true) @map("is_active")

  locations StockLocation[]

  @@map("stock_yards")
}

model StockLocation {
  id             Int                  @id @default(autoincrement())
  yardId         Int                  @map("yard_id")
  /// Stable identifier referenced by movements/reports. Frozen once the
  /// location has any movement (UI-enforced); the display name stays free.
  code           String
  /// Free, editable display label (e.g. «A5 محافظات»).
  nameAr         String               @map("name_ar")
  /// Optional English display label. Nullable; rendered via localizedName()
  /// with an Arabic fallback when empty.
  nameEn         String?              @map("name_en")
  segment        StockLocationSegment
  unit           StockUnit
  /// Commercial grade this site holds. FIRST for GENERAL/GOVERNORATES,
  /// SECOND for ISOLATION, null for SHORTBAR (no grade). Not the same
  /// concept as `segment` — the "محافظات" distinction lives in `segment`.
  allowedGrade   SalesOrderGrade?     @map("allowed_grade")
  /// Indicative size for the site — used for map display and transfer
  /// suggestions only. The ACTUAL size is derived from current balance;
  /// this is not a hard constraint.
  expectedSizeId Int?                 @map("expected_size_id")
  isActive       Boolean              @default(true) @map("is_active")
  /// Virtual pass-through site for direct-from-production dispatch (cross-dock).
  /// Exactly one row is seeded with this flag. It never appears on the live map,
  /// in pickers, or in the location admin — it exists only so a truck loaded
  /// straight off the line still leaves a complete ledger trail (a receipt in,
  /// then a load-out) instead of no movement at all. Its balance stays ~zero.
  isVirtual      Boolean              @default(false) @map("is_virtual")
  sortOrder      Int                  @default(0) @map("sort_order")
  /// Position on the per-yard schematic grid (mirrors the PDF layout).
  /// Editable from the location admin screen; no drag-and-drop editor in v1.
  gridRow        Int                  @default(1) @map("grid_row")
  gridCol        Int                  @default(1) @map("grid_col")
  gridSpan       Int                  @default(1) @map("grid_span")
  notes          String?
  createdAt      DateTime             @default(now()) @map("created_at")
  updatedAt      DateTime             @updatedAt @map("updated_at")

  yard          StockYard       @relation(fields: [yardId], references: [id])
  expectedSize  SizeLookup?     @relation(fields: [expectedSizeId], references: [id])
  movements     StockMovement[]
  weighSessions WeighSession[]

  @@unique([yardId, code])
  @@index([segment, isActive])
  @@map("stock_locations")
}

model StockMovement {
  id               Int               @id @default(autoincrement())
  locationId       Int               @map("location_id")
  type             StockMovementType
  /// Rebar size — required for BUNDLE locations, null for SHORTBAR (tons).
  sizeId           Int?              @map("size_id")
  /// Commercial grade — set for rebar movements, null for shortbar.
  grade            SalesOrderGrade?
  /// Positive = inbound, negative = outbound. Bundles are whole numbers
  /// stored in this Decimal column; tons use up to 3 decimals.
  quantity         Decimal           @db.Decimal(12, 3)
  unit             StockUnit
  /// Links the two rows of a single transfer (TRANSFER_OUT + TRANSFER_IN).
  transferGroupId  String?           @map("transfer_group_id")
  /// Set for LOAD_OUT rows — the internal weigh session that produced it.
  weighSessionId   Int?              @map("weigh_session_id")
  /// Set for LOAD_OUT rows — the truck operation that was closed.
  truckOperationId Int?              @map("truck_operation_id")
  /// Work shift the entry belongs to — set on PRODUCTION_IN rows only.
  /// Normally derived from created_at; may point to the *previous* shift when
  /// the clerk records within the grace window right after a shift boundary.
  shift            StockShift?
  reason           String?
  /// Set on a PRODUCTION_IN that was corrected: points at the replacement
  /// PRODUCTION_IN. Quantity/location on this row stay immutable; the row is
  /// excluded from today's production feed so totals do not double-count.
  supersededById   Int?              @map("superseded_by_id")
  createdById      Int               @map("created_by_id")
  createdAt        DateTime          @default(now()) @map("created_at")

  location       StockLocation   @relation(fields: [locationId], references: [id])
  size           SizeLookup?     @relation(fields: [sizeId], references: [id])
  weighSession   WeighSession?   @relation(fields: [weighSessionId], references: [id])
  truckOperation TruckOperation? @relation(fields: [truckOperationId], references: [id])
  creator        User            @relation("StockMovementCreator", fields: [createdById], references: [id])
  supersededBy   StockMovement?  @relation("StockMovementSupersede", fields: [supersededById], references: [id])
  supersedes     StockMovement[] @relation("StockMovementSupersede")

  @@index([locationId, sizeId])
  @@index([truckOperationId])
  @@index([transferGroupId])
  @@index([type, createdAt])
  @@index([supersededById])
  @@map("stock_movements")
}

// ─── Truck / Weighbridge ──────────────────────────────────────────

model TruckOperation {
  id                   Int              @id @default(autoincrement())
  customerId           Int?             @map("customer_id")
  destinationId        Int?             @map("destination_id")
  plateNumber          String           @map("plate_number")
  driverName           String           @map("driver_name")
  salesOrderNumber     String?          @map("sales_order_number")
  status               TruckStatus      @default(Queued)
  tareWeightKg         Decimal?         @map("tare_weight_kg") @db.Decimal(10, 1)
  grossWeightKg        Decimal?         @map("gross_weight_kg") @db.Decimal(10, 1)
  tareTime             DateTime?        @map("tare_time")
  grossTime            DateTime?        @map("gross_time")
  notes                String?
  cancelReason         String?          @map("cancel_reason")
  closedAt             DateTime?        @map("closed_at")
  closedById           Int?             @map("closed_by_id")
  /// Weighbridge-card number issued by the finance-side legacy scale program
  /// for the same truck exit. Typed manually by the operator when closing the
  /// operation (mandatory at close — enforced in closeOperation) so both
  /// systems share one card number. Null only for Cancelled operations and
  /// rows closed before this field existed.
  externalCardNumber   String?          @unique @map("external_card_number")
  /// Timestamp when the loader confirmed loading completion. Null means no
  /// loader has confirmed yet. `enterGross` refuses to run while this is null
  /// — the strictest representation of the "loader must confirm before gross"
  /// rule, independent of the state machine.
  loadingConfirmedAt   DateTime?        @map("loading_confirmed_at")
  /// User id of the loader who confirmed loading completion. Set atomically
  /// with `loadingConfirmedAt` inside `confirmLoadingComplete`. Required for
  /// audit / dispute traceability.
  loaderId             Int?             @map("loader_id")
  /// Set when loading is reopened before gross. Internal loading duration
  /// counts from this timestamp (or first session if never reopened).
  lastReopenedAt       DateTime?        @map("last_reopened_at")
  /// Operational grade declared by logistics at registration time.
  /// Used as a temporary display source until a SalesOrder is linked.
  /// Priority rule: salesOrder.grade takes precedence when present.
  /// This field is intentionally named to distinguish it from the
  /// contract-authoritative grade on SalesOrder.
  operationalGrade     SalesOrderGrade? @map("operational_grade")
  /// True when this visit carries only bulk material that is NOT weighed on
  /// the internal scale (scrap / billet tying wire). Derived from the request
  /// items at registration (single scrap/billet-wire size). Such trucks skip
  /// internal weigh sessions entirely: only the external bridge tare + gross
  /// are recorded, and `enterGross` mirrors the round net as one
  /// system-generated `WeighSession` so by-size reports keep working.
  skipInternalWeighing Boolean          @default(false) @map("skip_internal_weighing")
  /// Optimistic-lock counter. Incremented on every correction of tare/gross
  /// so two operators editing the same record simultaneously are detected
  /// instead of silently overwriting each other.
  version              Int              @default(0)
  createdAt            DateTime         @default(now()) @map("created_at")
  updatedAt            DateTime         @updatedAt @map("updated_at")
  createdById          Int              @map("created_by_id")

  customer       Customer?          @relation("TruckCustomer", fields: [customerId], references: [id])
  destination    Destination?       @relation(fields: [destinationId], references: [id])
  salesOrder     SalesOrder?        @relation(fields: [salesOrderNumber], references: [orderNumber])
  creator        User               @relation("TruckCreator", fields: [createdById], references: [id])
  closer         User?              @relation("TruckCloser", fields: [closedById], references: [id])
  loader         User?              @relation("TruckLoader", fields: [loaderId], references: [id])
  sessions       WeighSession[]
  photos         TruckPhoto[]
  requestItems   TruckRequestItem[]
  rounds         BridgeRound[]
  stockMovements StockMovement[]

  @@index([customerId])
  @@index([destinationId])
  @@index([plateNumber])
  @@index([status])
  @@index([salesOrderNumber])
  @@index([createdAt])
  @@index([loaderId])
  @@index([status, createdAt(sort: Desc)])
  /// Dashboard / operations-stats queries filter on
  /// `status = 'Completed' AND closed_at >= X` — this composite index keeps
  /// them off a full scan as completed history grows.
  @@index([status, closedAt])
  @@map("truck_operations")
}

model TruckRequestItem {
  id               Int              @id @default(autoincrement())
  truckOperationId Int              @map("truck_operation_id")
  sizeId           Int              @map("size_id")
  /// Grade requested for this line. Allows the same size to appear twice on
  /// one truck request (e.g. 12mm FIRST + 12mm SECOND). Null = non-rebar or
  /// unspecified. Postgres treats NULLs as distinct in the composite unique
  /// below, so a partial unique index (grade IS NULL) in the migration keeps
  /// "same size, no grade" from duplicating.
  grade            SalesOrderGrade?
  bundleCount      Int?             @map("bundle_count")
  requestedTons    Decimal?         @map("requested_tons") @db.Decimal(10, 3)

  truckOperation TruckOperation @relation(fields: [truckOperationId], references: [id])
  size           SizeLookup     @relation(fields: [sizeId], references: [id])

  @@unique([truckOperationId, sizeId, grade])
  @@index([truckOperationId])
  @@map("truck_request_items")
}

/// One external-weighbridge round: the period between two consecutive bridge
/// weighings of the same truck visit. Round 1 starts at the tare weight; each
/// later round starts at the previous round's end weight (copied automatically
/// — never typed by an operator). The authoritative per-round net is
/// endWeightKg − startWeightKg. A round with endWeightKg = null is the
/// currently open round; `isFinal` marks the round closed by the final exit
/// weighing (its end weight equals TruckOperation.grossWeightKg).
model BridgeRound {
  id                 Int              @id @default(autoincrement())
  truckOperationId   Int              @map("truck_operation_id")
  roundNumber        Int              @map("round_number")
  /// One grade per round (management rule): a round may load several sizes
  /// but never mixes FIRST and SECOND grade rebar.
  grade              SalesOrderGrade?
  /// Material loaded in this round, for internal-weighing-exempt trucks
  /// (scrap / billet wire / …). Chosen by the loader at loading-complete when
  /// the truck carries more than one exempt size; the auto-generated mirror
  /// session at gross is attributed to it. Null for non-exempt trucks and
  /// legacy rounds.
  sizeId             Int?             @map("size_id")
  startWeightKg      Decimal          @map("start_weight_kg") @db.Decimal(10, 1)
  endWeightKg        Decimal?         @map("end_weight_kg") @db.Decimal(10, 1)
  startTime          DateTime         @map("start_time")
  endTime            DateTime?        @map("end_time")
  isFinal            Boolean          @default(false) @map("is_final")
  loadingConfirmedAt DateTime?        @map("loading_confirmed_at")
  loaderId           Int?             @map("loader_id")
  lastReopenedAt     DateTime?        @map("last_reopened_at")
  /// Optimistic-lock counter, mirrors TruckOperation.version semantics.
  version            Int              @default(0)
  createdAt          DateTime         @default(now()) @map("created_at")
  updatedAt          DateTime         @updatedAt @map("updated_at")

  truckOperation TruckOperation @relation(fields: [truckOperationId], references: [id])
  loader         User?          @relation("BridgeRoundLoader", fields: [loaderId], references: [id])
  size           SizeLookup?    @relation(fields: [sizeId], references: [id])
  sessions       WeighSession[]
  photos         TruckPhoto[]

  @@unique([truckOperationId, roundNumber])
  @@index([truckOperationId])
  @@index([loaderId])
  @@index([sizeId])
  @@map("bridge_rounds")
}

model WeighSession {
  id               Int      @id @default(autoincrement())
  truckOperationId Int      @map("truck_operation_id")
  /// Bridge round this internal weighing belongs to. Nullable only for rows
  /// created before the multi-round migration; new sessions always attach to
  /// the currently open round.
  bridgeRoundId    Int?     @map("bridge_round_id")
  sessionNumber    Int      @map("session_number")
  sizeId           Int?     @map("size_id")
  bundleCount      Int?     @map("bundle_count")
  weightTons       Decimal  @map("weight_tons") @db.Decimal(10, 3)
  /// Stock source location this weigh was loaded from. Nullable: historical
  /// sessions (pre-stock-module) and exempt-truck mirror sessions have none.
  /// Required in the UI for rebar/shortbar loads once the stock module is live.
  sourceLocationId Int?     @map("source_location_id")
  /// True when the load came straight off the production line (cross-dock) with
  /// no yard stop. `sourceLocationId` stays null; at close a paired receipt +
  /// load-out is written against the virtual location for the ledger trail.
  fromProduction   Boolean  @default(false) @map("from_production")
  /// Optimistic-lock counter. Incremented on every edit so two operators
  /// editing the same weigh session simultaneously are detected.
  version          Int      @default(0)
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  truckOperation TruckOperation  @relation(fields: [truckOperationId], references: [id])
  bridgeRound    BridgeRound?    @relation(fields: [bridgeRoundId], references: [id])
  size           SizeLookup?     @relation(fields: [sizeId], references: [id])
  sourceLocation StockLocation?  @relation(fields: [sourceLocationId], references: [id])
  stockMovements StockMovement[]

  @@unique([truckOperationId, sessionNumber])
  @@index([truckOperationId])
  @@index([bridgeRoundId])
  @@index([sourceLocationId])
  @@map("weigh_sessions")
}

model TruckPhoto {
  id               Int      @id @default(autoincrement())
  truckOperationId Int      @map("truck_operation_id")
  /// Bridge round this photo documents. Null for photos uploaded before the
  /// first round opens (pre-tare) — those are adopted into round 1 when it is
  /// created — and for rows that predate the multi-round migration.
  bridgeRoundId    Int?     @map("bridge_round_id")
  filePath         String   @map("file_path")
  capturedAt       DateTime @default(now()) @map("captured_at")

  truckOperation TruckOperation @relation(fields: [truckOperationId], references: [id])
  bridgeRound    BridgeRound?   @relation(fields: [bridgeRoundId], references: [id])

  @@index([truckOperationId])
  @@index([bridgeRoundId])
  @@map("truck_photos")
}

// ─── Idempotency ──────────────────────────────────────────────────
//
// Stores the response of a successful write request so that a client retrying
// the same (user, idempotency-key) pair within the TTL gets the original
// response replayed instead of the operation running twice. Compound PK on
// (user_id, key) scopes keys per-user so one operator cannot shadow another's.
//
// `request_hash` is sha256 of `method\npath\nbodyText`. If the same key is
// reused with a different hash we reject with 409 to catch client bugs where
// the key survives across unrelated requests.
//
// A background job (not part of this migration) should periodically delete
// rows where expires_at < now().
model IdempotencyKey {
  userId         Int      @map("user_id")
  key            String
  method         String
  path           String
  requestHash    String   @map("request_hash")
  responseStatus Int      @map("response_status")
  responseBody   Json     @map("response_body")
  createdAt      DateTime @default(now()) @map("created_at")
  expiresAt      DateTime @map("expires_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, key])
  @@index([expiresAt])
  @@map("idempotency_keys")
}

// ─── Billet Receiving (Supplier Contracts + Inbound Receipts) ─────
//
// A self-contained inbound module. SupplierContract tracks a single total
// contracted weight plus a per-length piece counter. Remaining balances are
// NEVER stored — they are computed in the service layer from completed
// receipts to avoid drift. A receipt walks a 3-actor flow:
//   Registered → Loaded (external scale, gross) → Unloading (internal loader
//   photo) → AwaitingExit (counted pieces + rejects) → Completed (external
//   scale empty weight, net computed, contract deducted).

model SupplierContract {
  contractNumber     String                 @id @map("contract_number") // P-YY-NNN
  supplierName       String                 @map("supplier_name")
  /// Total contracted weight for ALL lengths combined.
  contractedWeightKg Decimal                @map("contracted_weight_kg") @db.Decimal(12, 3)
  status             SupplierContractStatus @default(Active)
  contractDate       DateTime               @map("contract_date") @db.Date
  notes              String?
  /// Optimistic-lock counter for status/edit races.
  version            Int                    @default(0)
  createdAt          DateTime               @default(now()) @map("created_at")
  updatedAt          DateTime               @updatedAt @map("updated_at")
  createdById        Int                    @map("created_by_id")
  updatedById        Int?                   @map("updated_by_id")

  creator     User                         @relation("BilletContractCreator", fields: [createdById], references: [id])
  updater     User?                        @relation("BilletContractUpdater", fields: [updatedById], references: [id])
  pieceLines  SupplierContractPieceLine[]
  receipts    BilletReceipt[]
  attachments SupplierContractAttachment[]

  @@index([status])
  @@index([supplierName])
  @@index([createdAt])
  @@map("supplier_contracts")
}

model SupplierContractAttachment {
  id                     Int      @id @default(autoincrement())
  supplierContractNumber String   @map("supplier_contract_number")
  filePath               String   @map("file_path")
  fileName               String   @map("file_name")
  fileSize               Int      @map("file_size") // bytes
  uploadedAt             DateTime @default(now()) @map("uploaded_at")
  uploadedById           Int      @map("uploaded_by_id")

  contract SupplierContract @relation(fields: [supplierContractNumber], references: [contractNumber], onDelete: Cascade)
  uploader User             @relation("BilletContractAttachmentUploader", fields: [uploadedById], references: [id])

  @@index([supplierContractNumber])
  @@map("supplier_contract_attachments")
}

model SupplierContractPieceLine {
  id                     Int    @id @default(autoincrement())
  supplierContractNumber String @map("supplier_contract_number")
  /// Billet length in metres (e.g. 6 or 12).
  billetLengthM          Int    @map("billet_length_m")
  contractedPieces       Int    @map("contracted_pieces")

  contract SupplierContract @relation(fields: [supplierContractNumber], references: [contractNumber])

  @@unique([supplierContractNumber, billetLengthM])
  @@index([supplierContractNumber])
  @@map("supplier_contract_piece_lines")
}

model BilletReceipt {
  id                     Int                 @id @default(autoincrement())
  receiptNumber          String              @unique @map("receipt_number") // R-YY-NNNN
  supplierContractNumber String              @map("supplier_contract_number")
  driverName             String              @map("driver_name")
  plateNumber            String              @map("plate_number")
  driverNationalId       String?             @map("driver_national_id")
  /// Declared weight from the supplier's shipping order. Informational diff
  /// against our own net is reported at close time.
  declaredWeightKg       Decimal             @map("declared_weight_kg") @db.Decimal(12, 3)
  status                 BilletReceiptStatus @default(Registered)

  /// External weighbridge — loaded (gross) on entry, empty (tare) on exit.
  loadedWeightKg Decimal?  @map("loaded_weight_kg") @db.Decimal(10, 1)
  entryTime      DateTime? @map("entry_time")
  emptyWeightKg  Decimal?  @map("empty_weight_kg") @db.Decimal(10, 1)
  exitTime       DateTime? @map("exit_time")

  /// Internal unloading — photo starts the duration timer, count entry ends it.
  unloadingPhotoPath  String?   @map("unloading_photo_path")
  unloadingPhotoAt    DateTime? @map("unloading_photo_at")
  countEnteredAt      DateTime? @map("count_entered_at")
  /// Mandatory when counted pieces differ from the registered (declared) count.
  countMismatchReason String?   @map("count_mismatch_reason")

  /// Net = loaded − empty, computed and stored at close. Rejected pieces leave
  /// with the truck, so the net naturally represents the accepted quantity.
  netWeightKg  Decimal? @map("net_weight_kg") @db.Decimal(10, 1)
  bundleCount  Int?     @map("bundle_count")
  notes        String?
  cancelReason String?  @map("cancel_reason")

  /// A completed historical withdrawal recorded after the contract already
  /// existed in reality, before this ERP tracked the physical receiving flow.
  isPriorWithdrawal   Boolean   @default(false) @map("is_prior_withdrawal")
  priorWithdrawalDate DateTime? @map("prior_withdrawal_date") @db.Date

  /// A signed balance correction (weight and/or pieces may be negative).
  /// Aggregations must NOT clamp piece deltas of adjustment rows to zero.
  isAdjustment Boolean @default(false) @map("is_adjustment")

  version     Int       @default(0)
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  createdById Int       @map("created_by_id")
  closedById  Int?      @map("closed_by_id")
  closedAt    DateTime? @map("closed_at")

  contract    SupplierContract          @relation(fields: [supplierContractNumber], references: [contractNumber])
  creator     User                      @relation("BilletReceiptCreator", fields: [createdById], references: [id])
  closer      User?                     @relation("BilletReceiptCloser", fields: [closedById], references: [id])
  pieceLines  BilletReceiptPieceLine[]
  attachments BilletReceiptAttachment[]

  @@index([supplierContractNumber])
  @@index([plateNumber])
  @@index([status])
  @@index([isPriorWithdrawal])
  @@index([isAdjustment])
  @@index([createdAt])
  @@map("billet_receipts")
}

model BilletReceiptPieceLine {
  id              Int  @id @default(autoincrement())
  billetReceiptId Int  @map("billet_receipt_id")
  billetLengthM   Int  @map("billet_length_m")
  /// Declared at registration (the order's piece count for this length).
  expectedPieces  Int  @map("expected_pieces")
  /// Entered by the internal loader at unloading; null until counted.
  countedPieces   Int? @map("counted_pieces")
  /// Confirmed rejects that leave with the truck.
  rejectedPieces  Int  @default(0) @map("rejected_pieces")

  receipt BilletReceipt @relation(fields: [billetReceiptId], references: [id], onDelete: Cascade)

  @@unique([billetReceiptId, billetLengthM])
  @@index([billetReceiptId])
  @@map("billet_receipt_piece_lines")
}

model BilletReceiptAttachment {
  id              Int      @id @default(autoincrement())
  billetReceiptId Int      @map("billet_receipt_id")
  filePath        String   @map("file_path")
  fileName        String   @map("file_name")
  fileSize        Int      @map("file_size") // bytes
  uploadedAt      DateTime @default(now()) @map("uploaded_at")
  uploadedById    Int      @map("uploaded_by_id")

  receipt  BilletReceipt @relation(fields: [billetReceiptId], references: [id], onDelete: Cascade)
  uploader User          @relation("BilletAttachmentUploader", fields: [uploadedById], references: [id])

  @@index([billetReceiptId])
  @@map("billet_receipt_attachments")
}

/// Admin-tunable operational settings, one row per key. Values are stored
/// as strings and parsed by the owning service (e.g. `analytics_start_date`
/// holds a YYYY-MM-DD operational date). Who/when history lives in AuditLog —
/// every write goes through a transaction with `logAudit`.
model SystemSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("system_settings")
}
